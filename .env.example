# Uscreen → Settings → Headless API. The only required variable.
USCREEN_PUBLISHABLE_KEY=usc_pub_live_xxxxxxxxxxxxxxxxxxxx

# Optional: override the Uscreen API base URL (defaults to production).
# USCREEN_API_URL=https://uscreen.io/api/headless/v1

# Optional: canonical origin for metadata (og:url, canonical links). On Vercel this is derived from
# VERCEL_PROJECT_PRODUCTION_URL automatically; set it only for another host.
# NEXT_PUBLIC_SITE_URL=https://uhodim.example.com
